bool battOffStatus = false;
int[0,3] cur;    // byte currently being examined (VOICE/BOFF/BON)
int[0,3] curSeq; // sequence tag travelling alongside 'cur' (meaningful only for
                 // genuine voice bytes -- see checkAndUpdate)
int[0,2] Z;      // last genuine voice byte held for repetition-substitution playback

// --- End-to-end delivery-correctness bookkeeping -----------------------
bool hasDelivered = false;   // has any genuine voice byte been delivered yet?
int[0,3] lastDelivered = 0;  // sequence number of the last one delivered
bool orderViolation = false; // latched true the first time delivery is out
                              // of order, duplicated, or a sequence number
                              // is skipped (indicating a lost/misrouted byte)

// Called exactly once per genuine (non-window) voice byte, at the moment
// it is accepted for delivery to the codec (Stage 3 -&gt; Stage 4 above).
void checkAndUpdate(int s) {
    if (!hasDelivered) {
        hasDelivered = true;
    } else if (s != (lastDelivered + 1) % SEQ_MOD) {
        orderViolation = true;
    }
    lastDelivered = s;
}

clock d;
int[0,1] curId=0, activeId=0;
int[0,3] originalType=0;


// Read-only predicates for compact transition guards.
bool isWindowTraffic()
{
    return (battOffStatus==true) &amp;&amp; cur!=RESYNC;
}

bool isNormalTraffic()
{
    return (battOffStatus==false) &amp;&amp; cur!=RESYNC;
}

bool isGenuineVoice()
{
    return (cur!=BOFF) &amp;&amp; cur==VOICE;
}

bool isAcceptableBon()
{
    return cur==BON &amp;&amp; (!PROTECTED || curId==activeId);
}

bool isMatchingResync()
{
    return PROTECTED &amp;&amp; cur==RESYNC &amp;&amp; curId==activeId;
}

bool needsNoCloseAck()
{
    return !PROTECTED || originalType!=BON;
}

bool needsCloseAck()
{
    return PROTECTED &amp;&amp; originalType==BON;
}

