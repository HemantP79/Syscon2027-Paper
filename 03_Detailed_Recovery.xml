		<name>IntermediateNode</name>
		<declaration>// Local state of an intermediate relay node (Fig. 5.3)
bool battOffStatus = false;
int[0,3] cur;    // byte currently being relayed (VOICE/BOFF/BON)
int[0,3] curSeq; // sequence tag travelling alongside 'cur'

clock d;
int[0,1] curId=0, activeId=0;


// Read-only predicates for compact transition guards.
bool isWindowTraffic()
{
    return (battOffStatus==true) &amp;&amp; cur!=RESYNC;
}

bool isNormalTraffic()
{
    return (battOffStatus==false) &amp;&amp; cur!=RESYNC;
}

bool isAcceptableBon()
{
    return cur==BON &amp;&amp; (!PROTECTED || curId==activeId);
}

bool isMatchingResync()
{
    return PROTECTED &amp;&amp; cur==RESYNC &amp;&amp; curId==activeId;
}

bool canDropBon()
{
    return LOSS_ENABLED &amp;&amp; cur==BON &amp;&amp; !bonDropped;
}

